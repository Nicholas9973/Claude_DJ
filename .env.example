# Copy to .env and fill in. .env is git-ignored; never commit real values.
# See docs/discord_setup.md.
DISCORD_TOKEN=paste-the-bot-token-here
# Comma-separated Discord user IDs allowed to control the music.
DISCORD_ALLOWED_USER_IDS=123456789012345678
# The channel the bot listens in (it also answers allowed users by DM).
DISCORD_CHANNEL_ID=123456789012345678
